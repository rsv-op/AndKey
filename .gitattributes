# Git LFS for large ML models (optional - see GITHUB_AND_ANDROID_UPGRADES.md Option B)
*.onnx filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.traineddata filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text

# Ensure markdown templates are treated as text
*.md text eol=lf

# Keep Java files with correct line endings
*.java text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.pro text eol=lf
